{
  "name": "discord-forum-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Two-way bridge between a Discord channel and forum.imrnes.team",
  "main": "src/main.js",
  "scripts": {
    "start": "node src/main.js",
    "check": "npm run check:guard && npm run check:url && npm run check:client && npm run check:forum && npm run check:media && npm run check:intro && npm run check:notice",
    "probe:forum": "node scripts/probe-forum.js",
    "invite": "node scripts/invite-url.js",
    "probe:restart": "BRIDGE_DATA_DIR=$(mktemp -d) node scripts/probe-restart.js",
    "check:forum": "BRIDGE_DATA_DIR=$(mktemp -d) node scripts/smoke-forum.js",
    "check:client": "node scripts/check-nodebb-client.js",
    "check:url": "node scripts/check-nodebb-url.js",
    "check:media": "node scripts/smoke-media.js",
    "check:intro": "node scripts/smoke-thread-intro.js",
    "check:notice": "node scripts/smoke-notice.js",
    "check:guard": "node scripts/smoke-state-guard.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "discord.js": "^14.27.0"
  }
}
