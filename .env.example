# Discord application credentials
# Application ID  -> https://discord.com/developers/applications
DISCORD_APP_ID=
# Bot Token (Developer Portal -> Bot -> Reset Token) - REQUIRED to log in
DISCORD_BOT_TOKEN=
# Public Key (used to verify interaction signatures)
DISCORD_PUBLIC_KEY=
# Client Secret (NEVER commit this)
DISCORD_CLIENT_SECRET=

# Discord guild + channel the bridge mirrors
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
# Bot user id - filled automatically after the first successful login
DISCORD_BOT_USER_ID=

# NodeBB
NODEBB_URL=https://forum.imrnes.team
# dedicated user token, NOT the admin master token
NODEBB_API_TOKEN=
# uid of the forum account that authors bridged posts
NODEBB_AUTH_MODE=master
NODEBB_AUTH_MODE=master
NODEBB_BRIDGE_UID=

# Forum destination
FORUM_CATEGORY_SLUG=discord-bridge
FORUM_TOPIC_PREFIX=DISCORD

# Behaviour
SYNC_INTERVAL_SECONDS=20
# HTML marker embedded in bridged posts; used to break echo loops
BRIDGE_MARKER="<!-- discord-bridge -->"
RANK_SYNC_INTERVAL_SECONDS=300

# The "this discussion is now on the forum" confirmation posted in a Discord
# thread when it gets adopted onto the forum.
#   off    - not posted (default)
#   silent - posted with no notification badge/ping/push
#   on     - posted normally
# Every posted mode suppresses the message's link preview: the confirmation links
# back to the topic it announces, and NodeBB serves that topic's first post as both
# og:title and og:description, which made the preview repeat itself.
BRIDGE_NOTICE=off
